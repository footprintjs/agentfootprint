{
  "$schema": "https://typedoc.org/schema.json",
  "extends": "./typedoc.json",
  "out": "docs-next/content/docs/api",
  "publicPath": "/docs/api/",
  "entryFileName": "index",
  "readme": "none",
  "hidePageHeader": true,
  "hideBreadcrumbs": true,
  "gitRevision": "main",
  "disableGit": true,
  "basePath": ".",
  "sourceLinkTemplate": "https://github.com/footprintjs/agentfootprint/blob/main/src/{path}#L{line}"
}
