      ],
      "maps": [
        "./dist/types/doors/maps.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/cache/strategies/*.js",
    "**/cache/index.js",
    "**/lib/injection-engine/devWarnHost.js"
  ],
