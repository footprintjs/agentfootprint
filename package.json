    "./package.json": "./package.json",
    "./canonical-notes.json": "./canonical-notes.json"
  },
  "typesVersions": {
    "*": {
      "providers": [
        "./dist/types/doors/providers.d.ts"
      ],
      "memory": [
        "./dist/types/doors/memory.d.ts"
      ],
      "rag": [
        "./dist/types/doors/rag.d.ts"
